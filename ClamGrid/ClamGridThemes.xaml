<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:clam="clr-namespace:ClamGrid"
                    x:Class="ClamGrid.ClamGridThemes">

    <Style x:Key="ClamGridTheme"
           TargetType="clam:ClamGridView">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#121212}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#212121, Dark=#E0E0E0}" />
        <Setter Property="EmptyTextColor" Value="{AppThemeBinding Light=#9E9E9E, Dark=#757575}" />
        <Setter Property="HeaderBackground" Value="{AppThemeBinding Light=#1976D2, Dark=#1565C0}" />
        <Setter Property="HeaderTextColor" Value="{AppThemeBinding Light=White, Dark=White}" />
        <Setter Property="RowHeaderBackground" Value="{AppThemeBinding Light=#F5F5F5, Dark=#1F1F1F}" />
        <Setter Property="GridLineColor" Value="{AppThemeBinding Light=#E0E0E0, Dark=#323232}" />
        <Setter Property="FrozenLineColor" Value="{AppThemeBinding Light=#9E9E9E, Dark=#616161}" />
        <Setter Property="ScrollBarColor" Value="{AppThemeBinding Light=#8C64748B, Dark=#8C94A3B8}" />
        <Setter Property="SelectedBackground" Value="{AppThemeBinding Light=#BBDEFB, Dark=#0D47A1}" />
        <Setter Property="SelectedTextColor" Value="{AppThemeBinding Light=#0D47A1, Dark=#BBDEFB}" />
        <Setter Property="AscendingHeaderBackground" Value="{AppThemeBinding Light=#0097A7, Dark=#00838F}" />
        <Setter Property="DescendingHeaderBackground" Value="{AppThemeBinding Light=#F57C00, Dark=#EF6C00}" />
    </Style>

</ResourceDictionary>
