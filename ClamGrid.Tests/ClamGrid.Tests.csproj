<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <CodeAnalysisRuleSet>..\Analyzers.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <PropertyGroup>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClamGrid\ClamGrid.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Example\Models\ScenarioColumnCatalog.cs" Link="Example\ScenarioColumnCatalog.cs" />
    <Compile Include="..\Example\Models\TicketRow.cs" Link="Example\TicketRow.cs" />
    <Compile Include="..\Example\Models\ListScenario.cs" Link="Example\ListScenario.cs" />
    <Compile Include="..\Example\Models\ListScenario.SortCallback.cs" Link="Example\ListScenario.SortCallback.cs" />
  </ItemGroup>

</Project>
