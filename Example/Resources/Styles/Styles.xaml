<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:helpers="clr-namespace:Example.Modules.Helpers"
                    xmlns:clam="clr-namespace:ClamGrid;assembly=ClamGrid" xmlns:cmc="clr-namespace:MauiComponents.Controls;assembly=MauiComponents.Controls">

    <!-- ================================================================================ -->
    <!-- Value -->
    <!-- ================================================================================ -->

    <Color x:Key="PrimaryTextColor">#DE000000</Color>
    <Color x:Key="SecondaryTextColor">#99000000</Color>
    <Color x:Key="DisabledColor">#61000000</Color>

    <Color x:Key="GridSortableColor">#2E7D32</Color>
    <Color x:Key="GridUnsortableColor">#616161</Color>
    <Color x:Key="GridSelectedTextColor">White</Color>
    <Color x:Key="GridSelectedBackgroundColor">#448AFF</Color>

    <!-- ================================================================================ -->
    <!-- Main -->
    <!-- ================================================================================ -->

    <Style x:Key="MainGrid"
           TargetType="Grid">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="ColumnSpacing" Value="0" />
    </Style>

    <Style x:Key="ContainerLayout"
           TargetType="AbsoluteLayout">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="BackgroundColor" Value="White" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Header -->
    <!-- ================================================================================ -->

    <Style x:Key="HeaderGrid"
           TargetType="Grid">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="ColumnSpacing" Value="0" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="BackgroundColor" Value="{StaticResource BlueDarken4}" />
    </Style>

    <Style x:Key="HeaderTitleLabel"
           TargetType="Label">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Function -->
    <!-- ================================================================================ -->

    <Style x:Key="FunctionGrid"
           TargetType="Grid">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="ColumnSpacing" Value="1" />
    </Style>

    <Style x:Key="FunctionButtonBase"
           TargetType="Button">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="20" />
    </Style>

    <Style x:Key="FunctionButton1"
           TargetType="Button"
           BasedOn="{StaticResource FunctionButtonBase}">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource RedAccent3}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource RedAccent4}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource RedAccent3}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="FunctionButton2"
           TargetType="Button"
           BasedOn="{StaticResource FunctionButtonBase}">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource IndigoAccent3}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource IndigoAccent4}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource IndigoAccent3}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="FunctionButton3"
           TargetType="Button"
           BasedOn="{StaticResource FunctionButtonBase}">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource GreenAccent3}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource GreenAccent4}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource GreenAccent3}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="FunctionButton4"
           TargetType="Button"
           BasedOn="{StaticResource FunctionButtonBase}">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource OrangeAccent3}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource OrangeAccent4}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource OrangeAccent3}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ================================================================================ -->
    <!-- Sub Menu -->
    <!-- ================================================================================ -->

    <Style x:Key="SubMenuGrid"
           TargetType="Grid">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="ColumnSpacing" Value="1" />
    </Style>

    <Style x:Key="SubMenuButton"
           TargetType="Button">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource CyanDefault}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource CyanDarken2}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource DisabledColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ================================================================================ -->
    <!-- Layout -->
    <!-- ================================================================================ -->

    <Style x:Key="MenuGrid"
           TargetType="Grid">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="RowSpacing" Value="6" />
        <Setter Property="ColumnSpacing" Value="6" />
    </Style>

    <Style x:Key="FillGrid"
           TargetType="Grid">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="ColumnSpacing" Value="0" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Button -->
    <!-- ================================================================================ -->

    <Style x:Key="MenuButton"
           TargetType="Button">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource BlueDarken2}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource DisabledColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ================================================================================ -->
    <!-- Label -->
    <!-- ================================================================================ -->

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource SecondaryTextColor}" />
    </Style>

    <Style x:Key="TitleLabel"
           TargetType="Label">
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryTextColor}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="ValueLabel"
           TargetType="Label">
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryTextColor}" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="StatusLabel"
           TargetType="Label">
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="TextColor" Value="{StaticResource SecondaryTextColor}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="HeightRequest" Value="24" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="ReportLabel"
           TargetType="Label">
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="TextColor" Value="{StaticResource SecondaryTextColor}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Picker -->
    <!-- ================================================================================ -->

    <Style x:Key="SelectPicker"
           TargetType="Picker">
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryTextColor}" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Grid -->
    <!-- ================================================================================ -->

    <!-- Grid style declared as a resource; the list grids refer to it with GridStyle="{StaticResource ListGridStyle}" -->
    <clam:GridStyle x:Key="ListGridStyle"
                    FontFamily="monospace"
                    TextColor="Black"
                    AscendingHeaderBackground="#1565C0" AscendingSortMark="▲" Background="White" DescendingHeaderBackground="#EF6C00"
                    DescendingSortMark="▼" GridLineColor="Gray" HeaderBackground="#424242" HeaderTextColor="White"
                    RowHeadersVisible="False" />

    <!-- Row colors by status -->
    <helpers:StatusColorSelector x:Key="StatusColorSelector"
                                 ActiveColor="#FFF59D" CompletedColor="#F8BBD0" PendingColor="#B3E5FC" />

    <!-- Common settings of the list grids -->
    <Style x:Key="ListGrid"
           TargetType="clam:ClamGridView">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="AllowColumnResizing" Value="True" />
        <Setter Property="AllowColumnConfiguration" Value="True" />
        <Setter Property="BackgroundColor" Value="White" />
    </Style>
    <!-- ================================================================================ -->
    <!-- Setting sheet -->
    <!-- ================================================================================ -->

    <Style x:Key="SettingSheet"
           TargetType="cmc:BottomSheetView">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="HalfExpandedRatio" Value="0.45" />
    </Style>

    <Style x:Key="SheetStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="12,0,12,12" />
        <Setter Property="Spacing" Value="4" />
    </Style>

    <Style x:Key="SheetTitle"
           TargetType="Label">
        <Setter Property="Padding" Value="2,6,2,0" />
        <Setter Property="TextColor" Value="{StaticResource SecondaryTextColor}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="SheetGrid"
           TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="6" />
        <Setter Property="RowSpacing" Value="4" />
    </Style>

    <Style x:Key="SheetSwitchLabel"
           TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource PrimaryTextColor}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="SheetSwitch"
           TargetType="Switch">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Scale" Value="0.75" />
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="OnColor" Value="{StaticResource BlueDefault}" />
    </Style>

    <Style x:Key="SheetButton"
           TargetType="Button">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="BorderColor" Value="{StaticResource GrayLighten1}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryTextColor}" />
    </Style>

</ResourceDictionary>
