<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:clam="clr-namespace:ClamGrid;assembly=ClamGrid"
             xmlns:behaviors="clr-namespace:Example.Behaviors"
             xmlns:shell="clr-namespace:Example.Shell"
             xmlns:module="clr-namespace:Example.Modules.Grid"
             x:Class="Example.Modules.Grid.GridListView"
             x:DataType="{x:Type module:GridListViewModel}"
             s:BindingContextResolver.Type="{x:Type module:GridListViewModel}"
             shell:ShellProperty.Title="商品一覧"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function2Text="Rows"
             shell:ShellProperty.Function3Text="Mode"
             shell:ShellProperty.Function4Text="Column"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True"
             shell:ShellProperty.Function3Enabled="True"
             shell:ShellProperty.Function4Enabled="True">

    <Grid Style="{StaticResource FillGrid}"
          RowDefinitions="Auto,*,Auto,Auto,Auto">
        <Label Grid.Row="0"
               Style="{StaticResource ValueLabel}"
               Text="{Binding SelectionText}" />

        <clam:ClamGridView Grid.Row="1"
                           ItemsSource="{Binding Rows}"
                           SelectionMode="{Binding SelectionMode}"
                           IsReadOnly="False"
                           GridStyle="{Binding GridStyle}"
                           SelectAllCommand="{Binding SelectAllCommand}"
                           ColumnConfigurationCommand="{Binding ColumnConfigurationCommand}"
                           behaviors:GridBind.Controller="{Binding Grid}" />

        <Label Grid.Row="2"
               Style="{StaticResource StatusLabel}"
               Text="{Binding Statistics}" />

        <Label Grid.Row="3"
               Style="{StaticResource StatusLabel}"
               Text="{Binding Status}" />

        <Grid Grid.Row="4"
              Style="{StaticResource SubMenuGrid}"
              ColumnDefinitions="*,*,*,*">
            <Button Grid.Column="0"
                    Style="{StaticResource SubMenuButton}"
                    Command="{Binding ScrollTopCommand}"
                    Text="先頭" />
            <Button Grid.Column="1"
                    Style="{StaticResource SubMenuButton}"
                    Command="{Binding ScrollEndCommand}"
                    Text="末尾" />
            <Button Grid.Column="2"
                    Style="{StaticResource SubMenuButton}"
                    Command="{Binding FontCommand}"
                    Text="文字" />
            <Button Grid.Column="3"
                    Style="{StaticResource SubMenuButton}"
                    Command="{Binding ActionCommand}"
                    Text="操作例" />
        </Grid>
    </Grid>

</ContentView>
