<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Example.Shell"
             xmlns:behaviors="clr-namespace:Example.Behaviors"
             xmlns:module="clr-namespace:Example.Modules.Grid"
             xmlns:clam="clr-namespace:ClamGrid;assembly=ClamGrid"
             x:Class="Example.Modules.Grid.GridScenarioView"
             x:DataType="{x:Type module:GridScenarioViewModel}"
             s:BindingContextResolver.Type="{x:Type module:GridScenarioViewModel}"
             shell:ShellProperty.Title="一覧サンプル"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function2Text="Bulk"
             shell:ShellProperty.Function3Text="Clear"
             shell:ShellProperty.Function4Text="Column"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True"
             shell:ShellProperty.Function3Enabled="True"
             shell:ShellProperty.Function4Enabled="True">

    <Grid Style="{StaticResource FillGrid}"
          RowDefinitions="Auto,*,Auto,Auto">
        <Picker Grid.Row="0"
                Style="{StaticResource SelectPicker}"
                ItemsSource="{Binding ScenarioNames}"
                SelectedIndex="{Binding SelectedIndex}"
                Title="一覧の種類" />

        <clam:ClamGridView Grid.Row="1"
                           behaviors:GridBind.Controller="{Binding Grid}"
                           ItemsSource="{Binding Data}"
                           ColumnConfigurationCommand="{Binding ColumnConfigurationCommand}"
                           GridStyle="{Binding GridStyle}"
                           SelectAllCommand="{Binding SelectAllCommand}"
                           SelectionMode="{Binding SelectionMode}" />

        <Label Grid.Row="2"
               Style="{StaticResource StatusLabel}"
               Text="{Binding Status}" />

        <Grid Grid.Row="3"
              Style="{StaticResource SubMenuGrid}"
              ColumnDefinitions="*,*,*,*,*">
            <Button Grid.Column="0"
                    Style="{StaticResource SubMenuButton}"
                    Command="{Binding CommitCommand}"
                    Text="確認" />
            <Button Grid.Column="1"
                    Style="{StaticResource SubMenuButton}"
                    Command="{Binding SelectKeyCommand}"
                    Text="ID42" />
            <Button Grid.Column="2"
                    Style="{StaticResource SubMenuButton}"
                    Command="{Binding AdvanceCommand}"
                    Text="状態" />
            <Button Grid.Column="3"
                    Style="{StaticResource SubMenuButton}"
                    Command="{Binding ResetColumnsCommand}"
                    Text="列初期化" />
            <Button Grid.Column="4"
                    Style="{StaticResource SubMenuButton}"
                    Command="{Binding ReloadCommand}"
                    Text="再読込" />
        </Grid>
    </Grid>

</ContentView>
