<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Example.Shell"
             xmlns:module="clr-namespace:Example.Modules.Grid"
             x:Class="Example.Modules.Grid.GridQualityView"
             x:DataType="{x:Type module:GridQualityViewModel}"
             s:BindingContextResolver.Type="{x:Type module:GridQualityViewModel}"
             shell:ShellProperty.Title="自動評価"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <Grid Style="{StaticResource FillGrid}"
          RowDefinitions="Auto,*,Auto">
        <Label Grid.Row="0"
               Style="{StaticResource TitleLabel}"
               Text="機能・性能の自動評価" />

        <ContentView x:Name="Host"
                     Grid.Row="1" />

        <Label Grid.Row="2"
               Style="{StaticResource StatusLabel}"
               Text="{Binding Status}" />
    </Grid>

</ContentView>
